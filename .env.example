# Register your application at: https://developer.ifood.com.br
IFOOD_CLIENT_ID=your-ifood-client-id
IFOOD_CLIENT_SECRET=your-ifood-client-secret

# Application URL (for OAuth callbacks)
APP_URL=http://localhost:5173
